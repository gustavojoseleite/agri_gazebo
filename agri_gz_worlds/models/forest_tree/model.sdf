<?xml version="1.0"?>
<!--
  A tree of the mata: 6.7 m tall, 5.2 m across, on a trunk you can see under.

  Two ellipsoids, one inside the other. The outer one is the canopy and the
  inner one is the dense crown around the trunk, a shade lighter, and the
  reason for both is what the pair does to a sensor rather than what it does
  to a drawing. A single ellipsoid is one smooth surface: a camera sees one
  gradient across it and a depth sensor sees one clean hull, which is what a
  citrus in a row actually looks like but not what standing timber looks like.
  Two nested ellipsoids of different colours give the silhouette an interior,
  so the mata does not read as a row of oversized oranges.

  This is what a mata is planted with, and a mata is scattered rather than
  planted in rows, which is the other half of the difference: the worlds set
  these at random positions and yaws inside a blob, never at a spacing.

  The trunk is a third shape, 0.52 m of diameter with 2.59 m of clearance
  under the canopy, so a machine passes under the leaves and beside the stems.
  Nothing here collides either — see model://citrus_tree — so the mata is
  something a machine drives through and a camera sees, which is the trade
  these worlds are built on.

  In the farm worlds this geometry is inlined rather than included: 120 trees
  of mata as 120 models cost measurable milliseconds a step, and the same
  shapes inside one model per quadrant do not. The numbers below and the ones
  in SCENERY["forest_tree"] in scripts/generate_agriculture_worlds.py are the
  same numbers, and this file is where they are explained.
-->
<sdf version="1.10">
  <model name="forest_tree">
    <static>true</static>

    <link name="tree">
      <visual name="trunk">
        <pose>0 0 1.45 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.26</radius>
            <length>2.9</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.09 0.07 1</ambient>
          <diffuse>0.29 0.23 0.17 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <visual name="canopy">
        <pose>0 0 4.65 0 0 0</pose>
        <geometry>
          <ellipsoid><radii>2.58 2.50 2.06</radii></ellipsoid>
        </geometry>
        <material>
          <ambient>0.04 0.10 0.04 1</ambient>
          <diffuse>0.10 0.24 0.09 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <visual name="crown">
        <pose>0 0 4.90 0 0 0</pose>
        <geometry>
          <ellipsoid><radii>1.46 1.38 1.29</radii></ellipsoid>
        </geometry>
        <material>
          <ambient>0.07 0.15 0.05 1</ambient>
          <diffuse>0.19 0.38 0.13 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>

  </model>
</sdf>
