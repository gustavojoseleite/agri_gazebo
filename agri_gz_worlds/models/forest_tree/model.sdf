<?xml version="1.0"?>
<!--
  Uma árvore da mata: 6.7 m de altura, 5.2 m de largura, num tronco por baixo do qual se vê.

  Dois elipsoides, um dentro do outro. O de fora é a copa e o de dentro é a coroa densa em
  volta do tronco, um tom mais clara, e o motivo de ter os dois é o que o par faz com um
  sensor, não com um desenho. Um único elipsoide é uma superfície lisa: uma câmera vê um só
  gradiente nele e um sensor de profundidade vê um só casco limpo, que é o que uma laranjeira
  numa fileira realmente parece, mas não o que parece madeira em pé. Dois elipsoides
  aninhados de cores diferentes dão um interior à silhueta, e a mata não parece uma fileira
  de laranjas gigantes.

  É com isto que uma mata é plantada, e uma mata é espalhada e não plantada em fileiras, que
  é a outra metade da diferença: os mundos põem estas árvores em posições e guinadas
  aleatórias dentro de uma mancha, nunca num espaçamento.

  O tronco é uma terceira forma, com 0.52 m de diâmetro e 2.59 m de vão livre sob a copa,
  então uma máquina passa sob as folhas e ao lado dos troncos. Nada aqui colide também (veja
  `model://citrus_tree`), então a mata é algo que uma máquina atravessa e uma câmera vê, que
  é a troca em que estes mundos se baseiam.

  Nos mundos de fazenda esta geometria é embutida e não incluída: 120 árvores de mata como
  120 modelos custam milissegundos mensuráveis por passo, e as mesmas formas dentro de um
  modelo por quadrante não custam. Os números abaixo e os de `SCENERY["forest_tree"]` em
  `scripts/generate_agriculture_worlds.py` são os mesmos, e este arquivo é onde eles são
  explicados.
-->
<sdf version="1.10">
  <model name="forest_tree">
    <static>true</static>

    <link name="tree">
      <visual name="trunk">
        <pose>0 0 1.45 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.26</radius>
            <length>2.9</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.09 0.07 1</ambient>
          <diffuse>0.29 0.23 0.17 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <visual name="canopy">
        <pose>0 0 4.65 0 0 0</pose>
        <geometry>
          <ellipsoid><radii>2.58 2.50 2.06</radii></ellipsoid>
        </geometry>
        <material>
          <ambient>0.04 0.10 0.04 1</ambient>
          <diffuse>0.10 0.24 0.09 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <visual name="crown">
        <pose>0 0 4.90 0 0 0</pose>
        <geometry>
          <ellipsoid><radii>1.46 1.38 1.29</radii></ellipsoid>
        </geometry>
        <material>
          <ambient>0.07 0.15 0.05 1</ambient>
          <diffuse>0.19 0.38 0.13 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>

  </model>
</sdf>
