<?xml version="1.0"?>
<model>
  <name>forest_tree</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>Gustavo</name>
    <email>gujoseleite@gmail.com</email>
  </author>
  <description>
    Uma árvore da mata, com 6,71 m de altura sobre um tronco de 2,9 m: dois elipsoides
    aninhados, a copa externa e uma coroa mais clara por dentro, para que a madeira em pé não
    pareça uma laranjeira gigante. Copa a partir de 2,59 m de altura e sem colisão.
  </description>
</model>
