<?xml version="1.0"?>
<model>
  <name>forest_tree</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>Gustavo</name>
    <email>gujoseleite@gmail.com</email>
  </author>
  <description>
    A tree of the mata, 6.71 m tall on a 2.9 m trunk: two nested ellipsoids,
    the outer canopy and a lighter crown inside it, so standing timber does not
    read as an oversized citrus. Canopy from 2.59 m up, and no collision.
  </description>
</model>
