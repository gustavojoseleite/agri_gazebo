<?xml version="1.0"?>
<model>
  <name>citrus_tree</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>Gustavo</name>
    <email>gujoseleite@gmail.com</email>
  </author>
  <description>
    Laranjeira adulta, com 3,95 m de largura e 2,83 m de altura, como uma malha de
    sombreamento plano com frutos: um visual por árvore e uma copa irregular que o sol pode
    iluminar, em vez de um elipsoide liso. Há seis variantes em `meshes/`, além das corridas de
    2, 4 e 8 de onde as fileiras são geradas, todas escritas por
    `scripts/generate_citrus_meshes.py`.
  </description>
</model>
