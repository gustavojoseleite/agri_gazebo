<?xml version="1.0"?>
<model>
  <name>citrus_tree</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>Gustavo</name>
    <email>gujoseleite@gmail.com</email>
  </author>
  <description>
    Grown citrus, 3.95 m across and 2.83 m tall, as a flat shaded mesh with
    fruit on it: one visual per tree, and a lumpy crown that the sun can light
    instead of a smooth ellipsoid. Six variants live in meshes/, along with the
    runs of 2, 4 and 8 the rows are baked from, all written by
    scripts/generate_citrus_meshes.py.
  </description>
</model>
