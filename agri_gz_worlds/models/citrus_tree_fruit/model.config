<?xml version="1.0"?>
<model>
  <name>citrus_tree_fruit</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>Gustavo</name>
    <email>gujoseleite@gmail.com</email>
  </author>
  <description>
    A mesma laranjeira adulta de `citrus_tree`, com uma segunda malha de laranjas na copa:
    dois visuais por árvore, e a única coisa nestes mundos que se pode pedir a uma pilha de
    percepção que encontre e que não é uma fileira, uma estrada nem um tronco.
  </description>
</model>
