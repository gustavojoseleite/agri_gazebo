<?xml version="1.0"?>
<!--
  A mesma laranjeira adulta de `model://citrus_tree`, carregando frutos. Mesma copa, mesmos
  3.95 m de largura, mesma ausência de colisão.

  Dois visuais em vez de um: a malha da copa e uma segunda malha de laranjas dentro dela. Eles
  são separados porque o OBJ traz as cores no próprio `.mtl`, e um `<material>` num visual
  pintaria folhas e frutos com uma só cor.

  Esse segundo visual é todo o custo deste modelo, e é por isso que há dois modelos de
  laranjeira em vez de uma opção num parâmetro. O Gazebo cobra por entidade: um `talhao`
  plantado com frutos custa o dobro de entidades do mesmo `talhao` sem frutos, e não há
  corrida pré-gerada com frutos, então ele também abre mão das corridas de oito que mantêm
  barato um bloco simples. Fruto é a única coisa nestes mundos que se pode pedir a uma pilha
  de percepção que encontre e que não é uma fileira, uma estrada nem um tronco; por isso um
  `talhao` carrega frutos e os demais não.

  Ele lê as malhas de `model://citrus_tree/meshes/` em vez de manter uma cópia: 10 MB de OBJ
  têm um só lugar, e os dois modelos são a mesma árvore.
-->
<sdf version="1.10">
  <model name="citrus_tree_fruit">
    <static>true</static>

    <link name="tree">
      <visual name="canopy">
        <geometry>
          <mesh><uri>model://citrus_tree/meshes/citrus_a.obj</uri></mesh>
        </geometry>
      </visual>

      <visual name="fruit">
        <geometry>
          <mesh><uri>model://citrus_tree/meshes/citrus_a_fruit.obj</uri></mesh>
        </geometry>
      </visual>
    </link>

  </model>
</sdf>
