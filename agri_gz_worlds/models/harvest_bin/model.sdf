<?xml version="1.0"?>
<!--
  `Bin` de campo de madeira, com 1.2 m de lado, do tipo largado ao longo de uma rua durante a
  colheita e recolhido depois.

  Vale ter como modelo próprio porque é a versão honesta do problema dos obstáculos num
  pomar: ao contrário de uma árvore, não está em nenhum mapa de plantio, tem justamente a
  altura que se esconde sob a copa numa varredura de `lidar`, e na semana que vem estará em
  outro lugar. Estático, como todo o resto aqui, então fica onde a execução o pôs.
-->
<sdf version="1.10">
  <model name="harvest_bin">
    <static>true</static>

    <link name="bin">
      <collision name="collision">
        <pose>0 0 0.43 0 0 0</pose>
        <geometry><box><size>1.2 1.2 0.86</size></box></geometry>
      </collision>

      <visual name="body">
        <pose>0 0 0.4 0 0 0</pose>
        <geometry><box><size>1.2 1.2 0.8</size></box></geometry>
        <material>
          <ambient>0.34 0.25 0.14 1</ambient>
          <diffuse>0.55 0.41 0.24 1</diffuse>
          <specular>0.04 0.04 0.04 1</specular>
        </material>
      </visual>

      <visual name="rim">
        <pose>0 0 0.83 0 0 0</pose>
        <geometry><box><size>1.28 1.28 0.06</size></box></geometry>
        <material>
          <ambient>0.28 0.20 0.11 1</ambient>
          <diffuse>0.45 0.33 0.19 1</diffuse>
        </material>
      </visual>
    </link>

  </model>
</sdf>
