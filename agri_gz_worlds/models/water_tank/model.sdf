<?xml version="1.0"?>
<!--
  Caixa-d'água de irrigação, com 3 m de largura e 2.5 m de altura, sobre uma base de concreto.

  Cada campo tem exatamente uma, e sempre na cabeceira. Isso a torna útil além da decoração:
  um objeto único, alto e isolado, de tamanho conhecido, é o marco em que uma pilha de
  localização pode se firmar quando toda fileira parece igual às outras.
-->
<sdf version="1.10">
  <model name="water_tank">
    <static>true</static>

    <link name="pad">
      <collision name="collision">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry><box><size>4.0 4.0 0.1</size></box></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry><box><size>4.0 4.0 0.1</size></box></geometry>
        <material><ambient>0.55 0.55 0.53 1</ambient><diffuse>0.68 0.68 0.66 1</diffuse></material>
      </visual>
    </link>

    <link name="tank">
      <pose>0 0 1.35 0 0 0</pose>
      <collision name="collision">
        <geometry><cylinder><radius>1.5</radius><length>2.5</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>1.5</radius><length>2.5</length></cylinder></geometry>
        <material>
          <ambient>0.10 0.20 0.35 1</ambient>
          <diffuse>0.15 0.32 0.55 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>
    </link>

    <link name="lid">
      <pose>0 0 2.65 0 0 0</pose>
      <visual name="visual">
        <geometry><cylinder><radius>1.55</radius><length>0.1</length></cylinder></geometry>
        <material><ambient>0.20 0.20 0.22 1</ambient><diffuse>0.28 0.28 0.30 1</diffuse></material>
      </visual>
    </link>

  </model>
</sdf>
