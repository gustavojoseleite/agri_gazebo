<?xml version="1.0"?>
<model>
  <name>citrus_round</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>Gustavo</name>
    <email>gujoseleite@gmail.com</email>
  </author>
  <description>
    Uma laranjeira adulta como tronco e um único elipsoide, com 3,12 m de largura e 2,76 m
    de altura, com 0,44 m de tronco à mostra. É a esfera de onde a malha de `citrus_tree`
    é tirada, sem nada da malha: o bloco de controle, para saber o que uma pilha de
    percepção deve à folhagem e não ao formato do pomar. Sem colisão.
  </description>
</model>
