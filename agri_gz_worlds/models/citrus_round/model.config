<?xml version="1.0"?>
<model>
  <name>citrus_round</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>Gustavo</name>
    <email>gujoseleite@gmail.com</email>
  </author>
  <description>
    One grown citrus as a trunk and a single ellipsoid, 3.12 m across and
    2.76 m tall, with 0.44 m of trunk showing. The sphere citrus_tree's mesh is
    pushed out of, with none of the mesh on it: the control block, for telling
    what a perception stack owes to foliage rather than to the shape of the
    field. No collision.
  </description>
</model>
