<?xml version="1.0"?>
<model>
  <name>carreador</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>Gustavo</name>
    <email>gujoseleite@gmail.com</email>
  </author>
  <description>
    Not a model anyone places: a library of baked carreadores, one OBJ per
    world, holding every road of it as a named strip -- bare earth, running
    surface, wheel ruts and the reference line down the middle. The worlds
    pick the strips out by name with submesh, so a road is one visual
    however far it runs and however often the ground folds under it. Written
    by scripts/generate_agriculture_worlds.py along with the worlds
    themselves; nothing in meshes/ is edited by hand.
  </description>
</model>
