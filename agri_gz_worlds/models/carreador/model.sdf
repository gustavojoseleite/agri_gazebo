<?xml version="1.0"?>
<sdf version="1.10">
  <!--
    Um marcador de posição, para que o diretório seja um modelo bem formado e que
    `model://carreador/meshes/...` resolva onde quer que a biblioteca esteja instalada.
    As estradas em si fazem parte de cada mundo, não deste modelo.
  -->
  <model name="carreador">
    <static>true</static>
    <link name="link"/>
  </model>
</sdf>
