<?xml version="1.0"?>
<model>
  <name>bin_trailer</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>Gustavo</name>
    <email>gujoseleite@gmail.com</email>
  </author>
  <description>
    Reboque de quatro rodas carregado com três `bins` de campo, com o cabeçalho ao
    longo de +X. Acoplado atrás de um trator, são 9 m de veículo, e isso é o que de fato define
    a largura de um `carreador` e o quão fechadas podem ser as suas curvas.
  </description>
</model>
