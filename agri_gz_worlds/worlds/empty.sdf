<?xml version="1.0"?>
<!--
  Minimal world for Gazebo Harmonic: ground, sun, and the systems a ROS robot
  actually needs. The smoke test — if a vehicle misbehaves here, the world is
  not the reason.

  The plugin list is not boilerplate you can drop. Without Physics nothing
  moves; without SceneBroadcaster the GUI connects to a black void and no pose
  reaches ROS; without UserCommands the /world/.../create service does not
  exist, so `ros_gz_sim create` cannot spawn the robot at all. Contact is the
  one that is genuinely optional here — kept because bumper sensors are usually
  the next thing anyone adds.

  The last three are one per sensor family, and each is silent about its
  absence: a camera or lidar with no Sensors system, an IMU with no Imu system
  and a GNSS with no NavSat system all spawn, appear in the model, and simply
  never publish. Every world in this package carries all three for that reason.
-->
<sdf version="1.10">
  <world name="empty">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat"/>

    <gravity>0 0 -9.8</gravity>

    <!-- Where on Earth the origin of this world is. NavSat converts the local
         ENU position into a fix against this datum, and without it a GNSS
         sensor has nothing to report. Bebedouro, SP: citrus country, and the
         same datum in every world here so a recorded track means the same
         thing wherever it was driven. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>-20.9494</latitude_deg>
      <longitude_deg>-48.4794</longitude_deg>
      <elevation>570</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <!-- Explicit friction: the default is slippery enough that a
               driven axle spins its wheels instead of moving the vehicle. -->
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
