<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>agri_gz_worlds</name>
  <version>0.1.0</version>
  <description>
    Mundos do `Gazebo Harmonic` compartilhados por todos os robôs deste workspace.
  </description>
  <maintainer email="gujoseleite@gmail.com">Gustavo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Um pacote próprio, e não uma pasta dentro do pacote de um veículo, para que um
       segundo robô reúse os mesmos mundos em vez de copiá-los. -->
  <exec_depend>ros_gz_sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
