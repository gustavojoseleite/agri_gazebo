<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>autonomous_tractor_gz</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic bringup for the autonomous tractor: gz plugins, sensors and ros_gz bridge.</description>
  <maintainer email="gujoseleite@gmail.com">Gustavo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The dependency that defines the architecture: this package knows about
       autonomous_tractor_description, and the description knows nothing about
       this one. -->
  <exec_depend>autonomous_tractor_description</exec_depend>

  <exec_depend>agri_gz_bringup</exec_depend>
  <exec_depend>agri_gz_worlds</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
