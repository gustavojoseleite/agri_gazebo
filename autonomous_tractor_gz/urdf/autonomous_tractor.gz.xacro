<?xml version="1.0"?>
<!--
  O trator autônomo, como o Gazebo precisa vê-lo.

  Este arquivo inclui a descrição pura e acrescenta por cima tudo o que é só de
  simulação: o conjunto de tração, o atrito dos pneus e o comportamento dos
  sensores. Nada daqui vaza de volta para o autonomous_tractor_description, o que
  mantém aquele pacote utilizável só com o `rviz`, o `MoveIt` ou a máquina real.

  Expanda-o para inspecionar o que de fato é criado:
    xacro autonomous_tractor.gz.xacro name:=autonomous_tractor
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="autonomous_tractor">

  <!-- O nome do modelo no Gazebo, passado pelo
       agri_gz_bringup/launch/sim.launch.py. Os tópicos dos sensores são
       montados a partir dele para que duas máquinas no mesmo mundo não
       publiquem uma por cima da outra. -->
  <xacro:arg name="name" default="autonomous_tractor"/>
  <xacro:property name="ns" value="/model/$(arg name)"/>

  <!-- Se este veículo leva algum sensor: IMU, GNSS, câmera. -->
  <xacro:arg name="sensors" default="true"/>

  <!-- A câmera em chave própria, porque é a que custa: os seguidores de um
       comboio levam GNSS e IMU (baratos, e com os quais se localizam), mas não
       câmera. O padrão é o que sensors:= disser. -->
  <xacro:arg name="camera" default="$(arg sensors)"/>

  <!-- Lidos pelo agri_gz_bringup/urdf/control.gz.xacro: o namespace ROS do
       veículo e os parâmetros dos controladores (o vehicles.py passa uma cópia
       restrita a esse namespace). -->
  <xacro:arg name="namespace" default=""/>
  <xacro:arg name="controllers" default="$(find vehicle_control)/config/autonomous_tractor.yaml"/>

  <!-- Traz os `links`, as juntas e as propriedades do params.xacro. Os
       controladores levam a própria cópia da geometria, e
       vehicle_control/test/test_configs.py falha se ela deixar de casar. -->
  <xacro:include filename="$(find autonomous_tractor_description)/urdf/autonomous_tractor.urdf.xacro"/>
  <xacro:include filename="$(find agri_gz_bringup)/urdf/sensors.gz.xacro"/>
  <xacro:include filename="$(find agri_gz_bringup)/urdf/control.gz.xacro"/>

  <!-- ── Pneus ───────────────────────────────────────────────────────────── -->

  <!-- Garras agrícolas no solo. No valor padrão as rodas patinam e uma máquina de
       4 t mal se move, o que parece um controlador quebrado. `mu2` menor que
       `mu1` é a aderência lateral que um pneu realmente tem, e é o que deixa o
       trator derrapar numa curva de cabeceira em vez de andar sobre trilhos. -->
  <xacro:gz_wheel_surface link="left_rear_wheel"/>
  <xacro:gz_wheel_surface link="right_rear_wheel"/>
  <xacro:gz_wheel_surface link="left_front_wheel"/>
  <xacro:gz_wheel_surface link="right_front_wheel"/>

  <!-- Sem sobrescrita de <material> aqui. O Gazebo não suporta scripts de
       material do Ogre (avisa e usa um próprio), e as cores do próprio URDF são
       as do objeto, que é o objetivo. -->

  <!-- ── Tração ──────────────────────────────────────────────────────── -->

  <!-- `ros2_control`, os mesmos controladores e a mesma configuração do `mock` e
       da máquina (vehicle_control/config/autonomous_tractor.yaml): direção
       Ackermann no eixo dianteiro, tração nas quatro rodas, o par traseiro vindo
       do controlador de direção e o par dianteiro do `front_drive_controller`.
       Só o plugin de hardware é do Gazebo; ver agri_gz_bringup/urdf/control.gz.xacro.
       As rodas dianteiras têm 0,45 m contra 0,75 m atrás; o
       `front_drive_controller` tem os dois raios e gira cada uma à sua
       velocidade no chão.
       -->
  <xacro:gz_ros2_control name="autonomous_tractor"/>

  <!-- ── Sensores ─────────────────────────────────────────────────────────── -->

  <!-- Só câmera e GNSS (e IMU). O lidar foi medido, no citrus_farm_60, em 30,4
       dos 62,1 segundos de relógio que levou para simular 20 s: metade do
       orçamento para um sensor, porque uma varredura de 360 graus percorre todo
       visual do mundo dez vezes por segundo. O agri_gz_bringup ainda traz a
       macro `gz_lidar_3d`. -->
  <xacro:if value="$(arg sensors)">
    <xacro:gz_imu link="imu_link" topic="${ns}/imu"/>
    <xacro:gz_navsat link="gnss_link" topic="${ns}/navsat"/>
    <!-- .../camera_front/image, e não .../camera_front: o Gazebo deriva o tópico
         de `camera info` do PAI do tópico da imagem, então o nome mais curto
         poria o `info` em /model/<name>/camera_info, onde uma segunda câmera o
         sobrescreveria. -->
    <xacro:if value="$(arg camera)">
      <xacro:gz_camera link="camera_front_link" optical_frame="camera_front_optical_frame"
                       topic="${ns}/camera_front/image"/>
    </xacro:if>
  </xacro:if>

</robot>
