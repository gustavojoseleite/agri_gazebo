<?xml version="1.0"?>
<!--
  The autonomous tractor, as Gazebo needs to see it.

  This file includes the pure description and adds everything simulation-only on
  top: the drivetrain, tyre friction, the sensors' behaviour. Nothing here leaks
  back into autonomous_tractor_description, which is what keeps that package
  usable with rviz alone, MoveIt or the real machine.

  Expand it to inspect what actually gets spawned:
    xacro autonomous_tractor.gz.xacro name:=autonomous_tractor
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="autonomous_tractor">

  <!-- The model's name in Gazebo, passed by agro_gz_bringup/launch/sim.launch.py.
       Sensor topics are built from it so that two machines in one world do not
       publish over each other. -->
  <xacro:arg name="name" default="autonomous_tractor"/>
  <xacro:property name="ns" value="/model/$(arg name)"/>

  <!-- Whether this machine carries its sensors. A convoy is five machines and
       a camera is the most expensive thing in any of these worlds — measured
       at 16.8 of 62.1 wall-seconds for one — so the followers are spawned
       with sensors:=false and only the leader looks at anything. -->
  <xacro:arg name="sensors" default="true"/>

  <!-- Brings in the links, joints and — just as importantly — the properties
       from params.xacro. The plugin below reads wheel_base, track and the wheel
       radii straight back out of them, so resizing the tractor cannot leave the
       controller computing turns for a machine that no longer exists. -->
  <xacro:include filename="$(find autonomous_tractor_description)/urdf/autonomous_tractor.urdf.xacro"/>
  <xacro:include filename="$(find agro_gz_bringup)/urdf/sensors.gz.xacro"/>

  <!-- ── Tyres ───────────────────────────────────────────────────────────── -->

  <!-- Agricultural lugs on soil. Left at the default the wheels slip and a 4 t
       machine barely moves, which reads like a broken controller. mu2 lower
       than mu1 is the lateral grip a tyre actually has, and it is what lets the
       tractor scrub round a headland turn instead of running on rails. -->
  <xacro:gz_wheel_surface link="left_rear_wheel"/>
  <xacro:gz_wheel_surface link="right_rear_wheel"/>
  <xacro:gz_wheel_surface link="left_front_wheel"/>
  <xacro:gz_wheel_surface link="right_front_wheel"/>

  <!-- No <material> override here. Gazebo does not support Ogre material
       scripts (it warns and substitutes one of its own), and the URDF's own
       colours are the prop's, which is the whole point. -->

  <!-- ── Drivetrain ──────────────────────────────────────────────────────── -->

  <!--
    Ackermann steering on the front axle, drive on all four wheels.

    Two plugin instances, not one, and the reason is the wheel sizes. The
    plugin turns a commanded linear velocity into a joint speed with a single
    <wheel_radius>: give it all four joints and the front pair — 0.45 m against
    0.75 m — is commanded at 60% of the speed the ground demands, and the front
    axle drags the machine instead of driving it. A real MFWD tractor solves
    that with a gear ratio between the axles; here each axle gets its own
    instance with its own radius, which is the same thing.

    Both instances listen on the same cmd_vel and both command the same two
    steering joints with identical values, so they cannot disagree. Only the
    rear instance owns the odometry and the odom -> base_footprint transform;
    the front one publishes its own to a topic nothing bridges, because there
    is no way to switch it off.
  -->
  <xacro:macro name="ackermann_axle" params="left_wheel right_wheel radius odom tf">
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>${left_wheel}</left_joint>
      <right_joint>${right_wheel}</right_joint>
      <left_steering_joint>left_steer_joint</left_steering_joint>
      <right_steering_joint>right_steer_joint</right_steering_joint>
      <kingpin_width>${kingpin_width}</kingpin_width>
      <steering_limit>${steering_limit}</steering_limit>
      <wheel_base>${wheel_base}</wheel_base>
      <wheel_separation>${track_rear}</wheel_separation>
      <wheel_radius>${radius}</wheel_radius>
      <!-- 15 km/h forward, 6 km/h back: a utility tractor's working range. -->
      <min_velocity>-1.7</min_velocity>
      <max_velocity>4.2</max_velocity>
      <min_acceleration>-3.0</min_acceleration>
      <max_acceleration>1.5</max_acceleration>
      <topic>${ns}/cmd_vel</topic>
      <odom_topic>${ns}/${odom}</odom_topic>
      <tf_topic>${ns}/${tf}</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </xacro:macro>

  <gazebo>
    <!-- Every topic is absolute and starts with /model/<name>/. A relative name
         here does NOT get scoped by the model — Gazebo publishes it at the root,
         so two machines in one world would both land on /cmd_vel and /odom.
         Writing the scope out is what keeps them apart, and it is the same
         string the bridge config is given. -->
    <xacro:ackermann_axle
                          left_wheel="left_rear_wheel_joint"
                          right_wheel="right_rear_wheel_joint"
                          radius="${rear_wheel_radius}"
                          odom="odom" tf="tf"/>

    <xacro:ackermann_axle
                          left_wheel="left_front_wheel_joint"
                          right_wheel="right_front_wheel_joint"
                          radius="${front_wheel_radius}"
                          odom="odom_front_unused" tf="tf_front_unused"/>

    <!-- Publishes the joint angles so robot_state_publisher can complete the TF
         tree. Without it the wheels are frozen in rviz while the tractor drives,
         and the steering never appears to turn at all.

         It publishes every physics step and takes no rate of its own — 1 kHz at
         this world's 1 ms step, measured. Six joints is cheap enough to leave
         alone; if it ever shows up in a profile, the place to throttle it is the
         bridge, not here. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>${ns}/joint_states</topic>
      <joint_name>left_rear_wheel_joint</joint_name>
      <joint_name>right_rear_wheel_joint</joint_name>
      <joint_name>left_front_wheel_joint</joint_name>
      <joint_name>right_front_wheel_joint</joint_name>
      <joint_name>left_steer_joint</joint_name>
      <joint_name>right_steer_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ── Sensors ─────────────────────────────────────────────────────────── -->

  <!-- Camera and GNSS only. The lidar was measured, in citrus_farm_60, at 30.4
       of the 62.1 wall-seconds it took to simulate 20 s — half the budget for
       one sensor, because a 360 degree scan walks every visual in the world
       ten times a second. agro_gz_bringup still ships the gz_lidar_3d macro. -->
  <xacro:if value="$(arg sensors)">
    <xacro:gz_imu link="imu_link" topic="${ns}/imu"/>
    <xacro:gz_navsat link="gnss_link" topic="${ns}/navsat"/>
    <!-- .../camera_front/image, not .../camera_front: Gazebo derives the
         camera info topic from the image topic's PARENT, so the shorter name
         would put the info on /model/<name>/camera_info, where a second
         camera would overwrite it. -->
    <xacro:gz_camera link="camera_front_link" optical_frame="camera_front_optical_frame"
                     topic="${ns}/camera_front/image"/>
  </xacro:if>

</robot>
