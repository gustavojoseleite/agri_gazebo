<?xml version="1.0"?>
<!--
  A pickup da fazenda, como o Gazebo precisa vê-la.

  Este arquivo inclui a descrição pura e acrescenta por cima tudo o que é só de
  simulação: o conjunto de tração, o atrito dos pneus e o comportamento dos
  sensores. Nada daqui vaza de volta para o pickup_description, o que mantém
  aquele pacote utilizável só com o `rviz`, o `MoveIt` ou um veículo real.

  Expanda-o para inspecionar o que de fato é criado:
    xacro pickup.gz.xacro name:=pickup
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pickup">

  <!-- O nome do modelo no Gazebo, passado pelo agri_gz_bringup/launch/sim.launch.py
       ou pelo convoy.launch.py. Os tópicos dos sensores são montados a partir dele
       para que cinco máquinas no mesmo mundo não publiquem umas por cima das outras. -->
  <xacro:arg name="name" default="pickup"/>
  <xacro:property name="ns" value="/model/$(arg name)"/>

  <!-- `tag_family`, `tag_id` e `tag_size` vão para a descrição, que os declara. Os
       sensores de navegação seguem o `sensor_profile` (`default`, `nominal` ou
       `ideal`; ver agri_gz_bringup/urdf/sensors.gz.xacro). `tag_texture` é o PNG da
       tag, de `agri_gz_bringup.tags.tag_texture`. -->
  <xacro:arg name="tag_texture" default=""/>

  <!-- Lidos pelo agri_gz_bringup/urdf/control.gz.xacro: o namespace ROS do
       veículo e os parâmetros dos controladores (o vehicles.py passa uma cópia
       restrita a esse namespace). -->
  <xacro:arg name="namespace" default=""/>
  <xacro:arg name="controllers" default="$(find vehicle_control)/config/pickup.yaml"/>

  <xacro:include filename="$(find pickup_description)/urdf/pickup.urdf.xacro"/>
  <xacro:include filename="$(find agri_gz_bringup)/urdf/sensors.gz.xacro"/>
  <xacro:include filename="$(find agri_gz_bringup)/urdf/control.gz.xacro"/>

  <!-- ── Textura da tag ──────────────────────────────────────────────────── -->

  <!-- Antes do `ros2_control`: a junta da textura precisa vir antes das juntas desse
       bloco, que não têm <child>, para quem lê o URDF procurando pelo filho. -->
  <xacro:gz_tag_texture size="$(arg tag_size)" texture="$(arg tag_texture)"/>

  <!-- ── Pneus ───────────────────────────────────────────────────────────── -->

  <!-- Pneus de estrada na terra, não garras agrícolas: menos aderência que a do
       trator, que é a diferença honesta entre os dois veículos e a razão de a
       pickup ser a que derrapa numa curva de cabeceira. -->
  <xacro:gz_wheel_surface link="left_rear_wheel" mu="1.1" mu2="0.95"/>
  <xacro:gz_wheel_surface link="right_rear_wheel" mu="1.1" mu2="0.95"/>
  <xacro:gz_wheel_surface link="left_front_wheel" mu="1.1" mu2="0.95"/>
  <xacro:gz_wheel_surface link="right_front_wheel" mu="1.1" mu2="0.95"/>

  <!-- ── Tração ──────────────────────────────────────────────────────── -->

  <!-- `ros2_control`, os mesmos controladores e a mesma configuração do `mock` e
       da máquina (vehicle_control/config/pickup.yaml): direção Ackermann no
       eixo dianteiro, tração nas quatro rodas, o par traseiro vindo do
       controlador de direção e o par dianteiro do `front_drive_controller`.
       Só o plugin de hardware é do Gazebo; ver agri_gz_bringup/urdf/control.gz.xacro.
       -->
  <xacro:gz_ros2_control name="pickup"/>

  <!-- ── Sensores ─────────────────────────────────────────────────────────── -->

  <!-- GNSS e IMU, nos mesmos lugares e pelas mesmas razões do trator: IMU no
       `base_link` e GNSS sobre o centro da máquina. A pickup não tem câmera: o
       líder segue a rota predefinida dos carreadores. -->
  <xacro:gz_imu link="imu_link" topic="${ns}/imu"/>
  <xacro:gz_navsat link="gnss_link" topic="${ns}/navsat"/>

  <!-- ── Pose real ────────────────────────────────────────────────────────── -->

  <xacro:gz_pose_publisher/>

</robot>
