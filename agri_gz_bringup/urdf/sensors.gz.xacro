<?xml version="1.0"?>
<!--
  A metade Gazebo das montagens de sensores declaradas em
  `vehicle_common_description/urdf/sensors.xacro`.

  Cada macro prende um <sensor> a um `link` que a descrição já criou, pelo
  nome. Esse é todo o contrato entre as duas metades: a descrição define onde
  o sensor fica, e este arquivo define como ele se comporta: taxa, ruído,
  campo de visão e o tópico em que publica.

  <gz_frame_id> não é opcional. Converter URDF em SDF funde as juntas fixas;
  assim, um lidar fixado no arco publicaria mensagens com o frame `base_link`,
  e toda nuvem de pontos cairia 2 m abaixo de onde foi medida. Nomear o frame
  explicitamente sobrevive à fusão.

  Os tópicos são absolutos e levam o nome do modelo. Um tópico de sensor
  relativo fica sob o nome do mundo além do modelo, então a ponte precisaria
  saber qual mundo está em execução para achá-lo.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Perfil dos sensores de navegação (`sensor_profile`), lido pelas macros
       `gz_imu` e `gz_navsat`:
         default  os valores de sempre: GNSS a 5 Hz com 1 m e 2 m de dispersão;
                  IMU a 100 Hz com ruído de uma unidade MEMS industrial;
         nominal  os de projeto: GNSS a 1 Hz com 2 cm e 4 cm; IMU a 20 Hz sem ruído;
         ideal    as taxas nominais sem ruído nenhum.
       `imu_noise` multiplica os desvios e as polarizações da IMU, então 0 a
       deixa sem ruído sem tirar os elementos do SDF. -->
  <xacro:arg name="sensor_profile" default="default"/>
  <xacro:property name="profile" value="$(arg sensor_profile)"/>
  <xacro:if value="${profile == 'default'}">
    <xacro:property name="gnss_rate" value="5"/>
    <xacro:property name="gnss_horizontal" value="1.0"/>
    <xacro:property name="gnss_vertical" value="2.0"/>
    <xacro:property name="imu_rate" value="100"/>
    <xacro:property name="imu_noise" value="1.0"/>
  </xacro:if>
  <xacro:if value="${profile == 'nominal'}">
    <xacro:property name="gnss_rate" value="1"/>
    <xacro:property name="gnss_horizontal" value="0.02"/>
    <xacro:property name="gnss_vertical" value="0.04"/>
    <xacro:property name="imu_rate" value="20"/>
    <xacro:property name="imu_noise" value="0.0"/>
  </xacro:if>
  <xacro:if value="${profile == 'ideal'}">
    <xacro:property name="gnss_rate" value="1"/>
    <xacro:property name="gnss_horizontal" value="0.0"/>
    <xacro:property name="gnss_vertical" value="0.0"/>
    <xacro:property name="imu_rate" value="20"/>
    <xacro:property name="imu_noise" value="0.0"/>
  </xacro:if>

  <!-- Lidar 3D. Os valores padrão descrevem uma unidade de 16 feixes: a classe de
       sensor que equipa uma máquina agrícola, com abertura vertical suficiente
       para ver o chão à frente e a copa ao lado. -->
  <xacro:macro name="gz_lidar_3d" params="link topic update_rate:=10
                                          h_samples:=900 v_samples:=16
                                          v_min:=-0.26 v_max:=0.26
                                          range_min:=0.6 range_max:=80.0">
    <gazebo reference="${link}">
      <sensor name="${link}" type="gpu_lidar">
        <topic>${topic}</topic>
        <gz_frame_id>${link}</gz_frame_id>
        <update_rate>${update_rate}</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>${h_samples}</samples>
              <resolution>1</resolution>
              <min_angle>${-pi}</min_angle>
              <max_angle>${pi}</max_angle>
            </horizontal>
            <vertical>
              <samples>${v_samples}</samples>
              <resolution>1</resolution>
              <min_angle>${v_min}</min_angle>
              <max_angle>${v_max}</max_angle>
            </vertical>
          </scan>
          <range>
            <min>${range_min}</min>
            <max>${range_max}</max>
            <resolution>0.01</resolution>
          </range>
          <!-- Um lidar sem ruído faz uma pilha de mapeamento parecer melhor do que
               é; 2 cm é aproximadamente o que essas unidades realmente fazem. -->
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- `IMU`. Os valores de ruído são os de uma unidade MEMS industrial: bons o
       bastante para fusão, ruins o bastante para que a odometria só com ela
       derive, que é o comportamento que vale reproduzir. -->
  <xacro:macro name="gz_imu" params="link topic update_rate:=${imu_rate}">
    <gazebo reference="${link}">
      <sensor name="${link}" type="imu">
        <topic>${topic}</topic>
        <gz_frame_id>${link}</gz_frame_id>
        <update_rate>${update_rate}</update_rate>
        <always_on>true</always_on>
        <imu>
          <!-- A orientação no referencial ENU do mundo. Sem isso, o Gazebo dá a orientação
               relativa à pose em que o veículo nasceu, e um veículo que nasce virado para o
               norte mede rumo zero. -->
          <orientation_reference_frame>
            <localization>ENU</localization>
          </orientation_reference_frame>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>${0.0003 * imu_noise}</stddev>
               <bias_mean>${0.0000075 * imu_noise}</bias_mean>
               <bias_stddev>${0.0000008 * imu_noise}</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>${0.0003 * imu_noise}</stddev>
               <bias_mean>${0.0000075 * imu_noise}</bias_mean>
               <bias_stddev>${0.0000008 * imu_noise}</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>${0.0003 * imu_noise}</stddev>
               <bias_mean>${0.0000075 * imu_noise}</bias_mean>
               <bias_stddev>${0.0000008 * imu_noise}</bias_stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>${0.017 * imu_noise}</stddev>
               <bias_mean>${0.1 * imu_noise}</bias_mean>
               <bias_stddev>${0.001 * imu_noise}</bias_stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>${0.017 * imu_noise}</stddev>
               <bias_mean>${0.1 * imu_noise}</bias_mean>
               <bias_stddev>${0.001 * imu_noise}</bias_stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>${0.017 * imu_noise}</stddev>
               <bias_mean>${0.1 * imu_noise}</bias_mean>
               <bias_stddev>${0.001 * imu_noise}</bias_stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- `GNSS`. O padrão é um metro de dispersão horizontal: uma posição sem
       correção. Um arranjo `RTK` é o mesmo sensor com `stddev` em centímetros,
       por isso é um parâmetro e não uma constante. O mundo precisa ter
       <spherical_coordinates>, ou o sensor não tem referência para converter.

       Os dois parâmetros estão em METROS, e o horizontal é dividido pelo
       comprimento de um grau de latitude antes de chegar ao Gazebo. Essa
       divisão não é estética: o `gz-sensors` soma o ruído horizontal à latitude
       e à longitude em GRAUS, então o óbvio <stddev>1.0</stddev> não é um metro
       de dispersão, e sim um grau, ou seja, 111 km. O sintoma é uma posição
       que parece plausível, deriva por continentes e é fácil de confundir com
       uma referência errada. O ruído vertical é aplicado à altitude, que já
       está em metros, então passa sem alteração.

       111320 m por grau é exato para a latitude e 7% errado para a longitude
       nesta latitude; o Gazebo aplica um só valor aos dois, então um só valor
       é o que há para dar a ele. -->
  <xacro:property name="metres_per_degree" value="111320.0"/>

  <xacro:macro name="gz_navsat" params="link topic update_rate:=${gnss_rate}
                                        horizontal_stddev:=${gnss_horizontal}
                                        vertical_stddev:=${gnss_vertical}">
    <gazebo reference="${link}">
      <sensor name="${link}" type="navsat">
        <topic>${topic}</topic>
        <gz_frame_id>${link}</gz_frame_id>
        <update_rate>${update_rate}</update_rate>
        <always_on>true</always_on>
        <navsat>
          <position_sensing>
            <horizontal><noise type="gaussian"><mean>0.0</mean>
              <stddev>${horizontal_stddev / metres_per_degree}</stddev></noise></horizontal>
            <vertical><noise type="gaussian"><mean>0.0</mean>
              <stddev>${vertical_stddev}</stddev></noise></vertical>
          </position_sensing>
        </navsat>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Câmera, a 10 Hz e com 120 graus por padrão.
       O `gz_frame_id` é o frame ÓPTICO, não o da montagem: uma imagem
       cujo cabeçalho diz `camera_link` fica 90 graus fora do que todo nó de
       visão assume, e o erro é silencioso.

       A calibração não é publicada no tópico informado aqui. O Gazebo a coloca
       no pai do tópico da imagem mais /camera_info; então, passando algo como
       .../camera_front/image, o par sai como .../camera_front/image e
       .../camera_front/camera_info. Passando .../camera_front, o `info` cai ao
       lado do modelo, onde a próxima câmera o sobrescreve. -->
  <xacro:macro name="gz_camera" params="link optical_frame topic update_rate:=10
                                        width:=1280 height:=720 hfov:=2.0944
                                        near:=0.2 far:=200.0
                                        k1:=-0.10 k2:=0.01 k3:=0.0 p1:=0.0 p2:=0.0">
    <gazebo reference="${link}">
      <sensor name="${link}" type="camera">
        <topic>${topic}</topic>
        <gz_frame_id>${optical_frame}</gz_frame_id>
        <update_rate>${update_rate}</update_rate>
        <always_on>true</always_on>
        <camera>
          <horizontal_fov>${hfov}</horizontal_fov>
          <image>
            <width>${width}</width>
            <height>${height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>${near}</near>
            <far>${far}</far>
          </clip>
          <optical_frame_id>${optical_frame}</optical_frame_id>
          <!-- Sem <noise>: a imagem sai limpa e só a distorção de Brown a
               degrada (o nó `camera_distortion` a aplica, pois o ogre2 não a
               desenha; o Gazebo só a publica no `camera_info`). -->
          <distortion>
            <k1>${k1}</k1>
            <k2>${k2}</k2>
            <k3>${k3}</k3>
            <p1>${p1}</p1>
            <p2>${p2}</p2>
            <center>0.5 0.5</center>
          </distortion>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Textura da tag. O quadrado preto da descrição (2 mm, em x de -0,002 a 0 no
       frame da tag) fica como está; este link é uma caixa de 1 mm logo à frente
       dele, presa por uma junta fixa, e é a única face que recebe o PNG
       (`albedo_map`). Assim a placa e o quadrado da descrição não mudam, e a
       textura vale só na simulação. -->
  <xacro:macro name="gz_tag_texture" params="size texture parent:=tag_rear">
    <link name="${parent}_texture">
      <visual>
        <origin xyz="-0.0025 0 0" rpy="0 0 0"/>
        <geometry><box size="0.001 ${size} ${size}"/></geometry>
        <material name="${parent}_texture"><color rgba="1 1 1 1"/></material>
      </visual>
    </link>
    <joint name="${parent}_texture_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${parent}_texture"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${parent}_texture">
      <visual>
        <material>
          <pbr><metal><albedo_map>${texture}</albedo_map></metal></pbr>
        </material>
      </visual>
    </gazebo>
  </xacro:macro>

  <!-- Pose real do modelo, publicada pelo Gazebo em /model/<nome>/pose como
       `gz.msgs.Pose` (e não `Pose_V`, por `use_pose_vector_msg` desligado). É a
       referência para medir o erro da localização; só a do modelo, sem as dos
       `links`. -->
  <xacro:macro name="gz_pose_publisher">
    <gazebo>
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- Não é um sensor, mas é a outra coisa que todo veículo precisa e que
       nenhuma descrição pode conter: o que os pneus fazem contra o chão. -->
  <xacro:macro name="gz_wheel_surface" params="link mu:=1.4 mu2:=1.2 kp:=1e7 kd:=100.0">
    <gazebo reference="${link}">
      <mu1>${mu}</mu1>
      <mu2>${mu2}</mu2>
      <kp>${kp}</kp>
      <kd>${kd}</kd>
    </gazebo>
  </xacro:macro>

</robot>
