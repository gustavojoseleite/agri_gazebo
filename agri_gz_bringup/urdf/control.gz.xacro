<?xml version="1.0"?>
<!--
  Como um veículo é conduzido no Gazebo: pelo `ros2_control`. O bloco
  <ros2_control> do próprio veículo, vindo de `vehicle_common_description`,
  recebe o plugin de hardware do Gazebo, e o `gz_ros2_control` executa dentro
  do simulador um `controller manager` para ele, no namespace do veículo. Os
  controladores e seus parâmetros são os do `vehicle_control`, os mesmos do
  `mock` e da máquina.

  O <veículo>.gz.xacro que inclui este arquivo declara os args que ele lê:
    namespace    o namespace ROS do veículo, vazio se não houver
    controllers  o arquivo de parâmetros: `vehicle_control/config/<robot>.yaml`
                 ou a cópia por namespace que o `vehicles.py` gera a partir dele
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find vehicle_common_description)/urdf/ros2_control.xacro"/>

  <xacro:macro name="gz_ros2_control" params="name">
    <xacro:ackermann_ros2_control name="${name}" plugin="gz_ros2_control/GazeboSimSystem"/>
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg controllers)</parameters>
        <xacro:if value="${'$(arg namespace)' != ''}">
          <ros><namespace>$(arg namespace)</namespace></ros>
        </xacro:if>
      </plugin>
    </gazebo>
  </xacro:macro>

</robot>
