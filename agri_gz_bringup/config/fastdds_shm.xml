<?xml version="1.0" encoding="UTF-8"?>
<!-- Perfil do Fast DDS para imagens grandes (1280x720 RGB, 2,7 MB por quadro). No padrão, o
     segmento de memória compartilhada é pequeno demais para um quadro, e o Fast DDS cai para o
     UDP, que perde fragmentos. Aqui o segmento cabe vários quadros, então os processos da
     mesma máquina trocam as imagens pela memória compartilhada. Uso:
       export FASTRTPS_DEFAULT_PROFILES_FILE=<este arquivo> -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_large</transport_id>
      <type>SHM</type>
      <segment_size>67108864</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="default_participant" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>shm_large</transport_id>
        <transport_id>udp</transport_id>
      </userTransports>
    </rtps>
  </participant>
</profiles>
