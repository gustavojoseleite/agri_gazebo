<?xml version="1.0"?>
<!--
  Wooden field bin, 1.2 m square, of the kind dropped along an alley during
  harvest and collected later.

  Worth having as its own model because it is the honest version of the
  obstacle problem in a grove: unlike a tree it is not on any planting map, it
  is exactly the height that hides under a canopy in a lidar scan, and next
  week it will be somewhere else. Static, like everything else here, so it
  stays where the run put it.
-->
<sdf version="1.10">
  <model name="harvest_bin">
    <static>true</static>

    <link name="bin">
      <collision name="collision">
        <pose>0 0 0.43 0 0 0</pose>
        <geometry><box><size>1.2 1.2 0.86</size></box></geometry>
      </collision>

      <visual name="body">
        <pose>0 0 0.4 0 0 0</pose>
        <geometry><box><size>1.2 1.2 0.8</size></box></geometry>
        <material>
          <ambient>0.34 0.25 0.14 1</ambient>
          <diffuse>0.55 0.41 0.24 1</diffuse>
          <specular>0.04 0.04 0.04 1</specular>
        </material>
      </visual>

      <visual name="rim">
        <pose>0 0 0.83 0 0 0</pose>
        <geometry><box><size>1.28 1.28 0.06</size></box></geometry>
        <material>
          <ambient>0.28 0.20 0.11 1</ambient>
          <diffuse>0.45 0.33 0.19 1</diffuse>
        </material>
      </visual>
    </link>

  </model>
</sdf>
